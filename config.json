{
  "telegram": {
    "bot_token": "${TELEGRAM_BOT_TOKEN}",
    "allowed_users": [],
    "allowed_chats": [],
    "group_allowed_chats": [],
    "home_channel": "",
    "proxy_url": "",
    "require_mention": true,
    "mention_patterns": [],
    "observe_unmentioned_group_messages": false,
    "ignored_threads": [],
    "exclusive_bot_mentions": true,
    "bots_require_mention": true,
    "allow_bots": false,
    "status_indicator": true,
    "drop_pending_on_cold_boot": false,
    "group_allow_from": [],
    "cron_thread_id": "",
    "notifications": "important",
    "inline_mode": true,
    "base_url": "",
    "base_file_url": "",
    "footer": true,
    "max_tools_shown": 6,
    "pin_while_working": true,
    "reply_to_trigger": true,
    "command_menu": [
      {
        "command": "help",
        "description": "Show all commands"
      },
      {
        "command": "new",
        "description": "Start a fresh conversation"
      },
      {
        "command": "model",
        "description": "Show or change model"
      },
      {
        "command": "status",
        "description": "Show session info"
      },
      {
        "command": "menu",
        "description": "Button menu"
      },
      {
        "command": "keyboard",
        "description": "Show quick buttons"
      },
      {
        "command": "stop",
        "description": "Stop the running agent"
      },
      {
        "command": "sessions",
        "description": "List or switch sessions"
      },
      {
        "command": "compress",
        "description": "Compress conversation context"
      },
      {
        "command": "proxy",
        "description": "WARP proxy on/off + status"
      },
      {
        "command": "cron",
        "description": "Scheduled tasks"
      },
      {
        "command": "goal",
        "description": "Standing goal (auto-continues)"
      }
    ],
    "footer_fields": [
      "model",
      "context_pct",
      "cwd",
      "latency"
    ],
    "batching": {
      "enabled": true,
      "hold_sec": 1.2
    }
  },
  "gateway": {
    "max_concurrent_updates": 8,
    "webhook": {
      "enabled": false,
      "url": "",
      "secret": "",
      "port": 8443
    },
    "routing": {
      "default_profile": "default",
      "rules": []
    },
    "profiles": {
      "default": {
        "workspace": "~/oc-workspace",
        "model": "opencode/ling-3.1-flash-free",
        "agent": "blackhat",
        "auto_approve": true,
        "timeout_sec": 900,
        "session_dir": "/opt/ops/yatim-full"
      }
    }
  },
  "proxy": {
    "enabled": true,
    "url": "http://127.0.0.1:8118",
    "no_proxy": "localhost,127.0.0.1,::1",
    "auto_rotate": true,
    "auto_cooldown_sec": 300
  },
  "stt": {
    "enabled": true,
    "provider": "auto",
    "model": "whisper-large-v3-turbo",
    "language": ""
  },
  "cron": {
    "enabled": true,
    "poll_sec": 30,
    "max_jobs": 50
  },
  "models": {
    "ctx_1m": true
  },
  "bot_loop_guard": {
    "enabled": true,
    "max_events": 20,
    "window_seconds": 300,
    "cooldown_seconds": 600
  },
  "personalities": {
    "concise": "Answer concisely. No preamble, no restating the question.",
    "sre": "You are a senior SRE: precise, ops-minded, and you verify before anything destructive."
  },
  "warp_cli": "warp-cli",
  "opencode_bin": "opencode",
  "poll_timeout": 30,
  "vision": {
    "fallback_model": "opencode/mimo-v2.6-flash-free"
  }
}